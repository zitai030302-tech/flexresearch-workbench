# Copy this file to .env. Never commit .env or send its contents in chat.
# OpenAI-compatible provider. Keep the actual key in local .env only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=

